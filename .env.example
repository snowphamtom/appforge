# AppForge LLM generation (local `npm run dev` only — never commit real keys)
# Priority: XAI → GEMINI → GROQ → OPENROUTER → OLLAMA → OPENAI (first set wins).
# Put keys in `.env` or `.env.local` (both loaded by the Vite generate plugin).

XAI_API_KEY=
# Optional override (default: grok-2-latest). Also accepts grok-3.
# XAI_MODEL=grok-2-latest

GEMINI_API_KEY=
# Google AI Studio / Gemini.
# Optional override (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Free cloud: https://console.groq.com
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Free/credits cloud: https://openrouter.ai
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/auto

# Local $0: Ollama (https://ollama.com) — set any of these to enable
# OLLAMA_ENABLED=1
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b
# OLLAMA_API_KEY=ollama

OPENAI_API_KEY=
# Optional override (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini
