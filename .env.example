# AppForge LLM generation (local `npm run dev` only — never commit real keys)
# Priority: XAI → GEMINI → OPENAI (first set key wins).
# Put keys in `.env` or `.env.local` (both loaded by the Vite generate plugin).

XAI_API_KEY=
# Optional override (default: grok-2-latest). Also accepts grok-3.
# XAI_MODEL=grok-2-latest

GEMINI_API_KEY=
# Google AI Studio / Gemini (OpenAI-compatible endpoint).
# Optional override (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

OPENAI_API_KEY=
# Optional override (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini
